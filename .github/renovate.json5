{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>canonical/data-platform//renovate_presets/base.json5",
    "helpers:pinGitHubActionDigests",
  ],
  // Between 1AM and 6:59AM, Friday mid-month
  schedule: ["* 1-6 14-21 * 5"],
  lockFileMaintenance: {
    enabled: true,
    // Between 1AM and 6:59AM, first Friday of the month
    schedule: ["* 1-6 1-7 * 5"],
  },
  commitMessagePrefix: "[RENOVATE] ",
  ignoreDeps: ["ubuntu"],
  enabledManagers: ["github-actions", "poetry"],
  packageRules: [
    {
      description: "Disable CI ubuntu version bumps",
      matchDatasources: ["github-runners"],
      enabled: false,
    },
    {
      description: "Disable Python version bumps in setup-python step",
      matchManagers: ["github-actions"],
      matchDatasources: ["python-version"],
      enabled: false,
    },
    {
      matchManagers: ["poetry"],
      rangeStrategy: "bump",
      groupName: "Python dependencies",
    },
    // Disable Python updates in pyproject.toml
    // (Python version should be updated when Ubuntu version is updated)
    {
      matchManagers: ["poetry"],
      // Renovate uses "dependencies" instead of "main" for top-level dependency group
      matchDepTypes: ["dependencies"],
      matchDepNames: ["python"],
      enabled: false,
    },
  ],
}
